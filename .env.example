# ==============================================================================
# Kendits Creative Studios V2 — Environment Configuration
# ==============================================================================

# EmailJS Client Credentials
# Create an account and obtain these from https://dashboard.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Optional Booking Provider URL (e.g. Cal.com / Calendly)
# If provided, a direct booking action can be exposed. If unset, the project form is used.
NEXT_PUBLIC_BOOKING_URL=
